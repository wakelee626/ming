[
  {"id":"drought-1628","year":1628,"title":"陕西大旱","text":"连年大旱，赤地千里，流民四起，饥民涌入州县。","effects":{"delta":[0,-5,0,-2],"provinces":[{"id":"shaanxi","delta":[-3,-8,-2,-2]}]},"choices":[{"label":"减赋赈济","effects":{"delta":[-30,8,0,1]}},{"label":"催征赋税","effects":{"delta":[20,-5,0,-2]}}]},
  {"id":"jisi-1629","year":1629,"title":"己巳之变","text":"皇太极率军绕道喜峰口入塞，兵临北京城下，京畿震动。","effects":{"delta":[0,-5,-5,-3],"provinces":[{"id":"beizhili","delta":[-8,-5,-8,0]},{"id":"liaodong","delta":[0,0,-5,0]}],"armies":[{"id":"jizhen-jun","men":-3000,"morale":-10},{"id":"jingying","men":-3000,"morale":-10}],"frontier":{"manchu":5},"rivals":[{"id":"hongtaiji","strength":5},{"id":"duoergun","strength":5}]},"choices":[{"label":"勤王抗敌","effects":{"delta":[-50,-2,5,2]}},{"label":"议和退兵","effects":{"delta":[20,0,-3,-5],"frontier":{"relations":5}}}]},
