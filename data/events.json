[
  {"id":"drought-1628","year":1628,"title":"陕西大旱","text":"连年大旱，赤地千里，流民四起，饥民涌入州县。","effects":{"delta":[0,-5,0,-2],"provinces":[{"id":"shaanxi","delta":[-3,-8,-2,-2]}]},"choices":[{"label":"减赋赈济","effects":{"delta":[-30,8,0,1]},"sets":["relieve-shaanxi"]},{"label":"催征赋税","effects":{"delta":[20,-5,0,-2]},"sets":["tax-shaanxi"]}]},
  {"id":"jisi-1629","year":1629,"title":"己巳之变","text":"皇太极率军绕道喜峰口入塞，兵临北京城下，京畿震动。","effects":{"delta":[0,-5,-5,-3],"provinces":[{"id":"beizhili","delta":[-8,-5,-8,0]},{"id":"liaodong","delta":[0,0,-5,0]}],"armies":[{"id":"jizhen-jun","men":-3000,"morale":-10},{"id":"jingying","men":-3000,"morale":-10}],"frontier":{"manchu":5},"rivals":[{"id":"hongtaiji","strength":5},{"id":"duoergun","strength":5}]},"choices":[{"label":"勤王抗敌","effects":{"delta":[-50,-2,5,2]},"sets":["resist-qing"]},{"label":"议和退兵","effects":{"delta":[20,0,-3,-5],"frontier":{"relations":5}},"sets":["peace-qing"]}]},
  {"id":"yuan-1630","year":1630,"title":"袁崇焕之死","text":"袁崇焕被磔于市，辽东将帅人人自危。","effects":{"delta":[0,0,-3,-4],"frontier":{"manchu":3}},"choices":[{"label":"力保袁崇焕","effects":{"delta":[0,0,1,2]},"sets":["saved-yuan"]},{"label":"顺从众议","effects":{"delta":[0,0,-2,-1]},"sets":["killed-yuan"]}]},
  {"id":"revolt-1631","year":1631,"title":"民变蜂起","text":"流寇啸聚，高迎祥、李自成崭露头角，陕豫震动。","effects":{"delta":[0,-4,-2,-2],"armies":[{"id":"shaanxi-jun","men":-2000,"morale":-5}],"rivals":[{"id":"lizicheng","strength":10},{"id":"gaoyingxiang","strength":5}]},"choices":[{"label":"派兵围剿","effects":{"delta":[-40,0,3,-1]},"sets":["suppress-rebels"]},{"label":"招抚安民","effects":{"delta":[-20,3,0,1]},"sets":["appease-rebels"]}]},
  {"id":"dengzhou-1632","year":1632,"title":"登州之乱","text":"孔有德叛军攻陷登州，掳掠州县，东江粮道中断。","effects":{"delta":[0,0,-3,-2],"provinces":[{"id":"shandong","delta":[-5,-4,-5,0]}],"armies":[{"id":"dengzhou-shuishi","men":-3000,"morale":-15}],"frontier":{"manchu":2}},"choices":[{"label":"调兵平叛","effects":{"delta":[-40,0,3,0]},"sets":["suppress-kong"]},{"label":"招安孔有德","effects":{"delta":[-20,-2,0,2]},"sets":["appease-kong"]}]},
  {"id":"kong-1633","year":1633,"title":"孔有德降清","text":"登州兵变，孔有德携红衣大炮降后金，敌我火力此消彼长。","effects":{"delta":[0,0,-4,-2],"frontier":{"manchu":4,"relations":-3}},"choices":[{"label":"厚抚军士","effects":{"delta":[-40,0,2,1]},"sets":["favor-soldiers"]},{"label":"严惩叛将","effects":{"delta":[0,0,1,-3]},"sets":["punish-traitors"]}]},
  {"id":"qing-1634","year":1634,"title":"清军入宣大","text":"皇太极率军西征，破宣府、大同，掳掠人口财物。","effects":{"delta":[-50,-5,-4,-2],"provinces":[{"id":"shanxi","delta":[-4,-6,-5,0]}],"armies":[{"id":"xuanda-jun","men":-3000,"morale":-10},{"id":"datong-jun","men":-2000,"morale":-8}],"frontier":{"manchu":4},"rivals":[{"id":"hongtaiji","strength":5}]},"choices":[{"label":"整军迎击","effects":{"delta":[-40,-1,4,0]},"sets":["resist-qing"]},{"label":"坚壁清野","effects":{"delta":[0,2,1,0]},"sets":["scorched-earth"]}]},
  {"id":"fengyang-1635","year":1635,"title":"凤阳皇陵被焚","text":"张献忠攻破凤阳，焚毁皇陵，崇祯下罪己诏。","effects":{"delta":[-40,-5,-2,-4],"provinces":[{"id":"nanzhili","delta":[-5,-6,-3,0]}],"rivals":[{"id":"zhangxianzhong","strength":10,"influence":8}]},"choices":[{"label":"严剿张献忠","effects":{"delta":[-40,0,4,-1]},"sets":["hunt-zhang"]},{"label":"招抚流寇","effects":{"delta":[-25,2,0,0]},"sets":["appease-zhang"]}]},
