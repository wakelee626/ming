  {"id":"famine-1640","year":1640,"title":"大旱蝗灾","text":"大旱继以蝗灾，赤地千里，饿殍遍野。","effects":{"delta":[-40,-8,0,-2],"provinces":[{"id":"henan","delta":[-2,-6,0,-1]},{"id":"shaanxi","delta":[-2,-6,0,-1]}]},"choices":[{"label":"开仓放粮","effects":{"delta":[-50,6,0,1]}},{"label":"征收留饷","effects":{"delta":[15,-4,0,-2]}}]},
