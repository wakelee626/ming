  {"id":"lizicheng-1642","year":1642,"title":"李自成克襄阳","text":"李自成下襄阳，改称新顺王，流寇渐成心腹大患。","effects":{"delta":[-30,-5,-3,-3],"armies":[{"id":"huguang-jun","men":-2000,"morale":-10},{"id":"chuan-jun","men":-1500,"morale":-10}],"rivals":[{"id":"lizicheng","strength":15,"influence":10}]},"choices":[{"label":"集中剿灭","effects":{"delta":[-40,-1,4,-1]}},{"label":"先稳北方","effects":{"delta":[0,-2,-2,1]}}]},
