  {"id":"revolt-1631","year":1631,"title":"民变蜂起","text":"流寇啸聚，高迎祥、李自成崭露头角，陕豫震动。","effects":{"delta":[0,-4,-2,-2],"armies":[{"id":"shaanxi-jun","men":-2000,"morale":-5}],"rivals":[{"id":"lizicheng","strength":10},{"id":"gaoyingxiang","strength":5}]},"choices":[{"label":"派兵围剿","effects":{"delta":[-40,0,3,-1]}},{"label":"招抚安民","effects":{"delta":[-20,3,0,1]}}]},
  {"id":"kong-1633","year":1633,"title":"孔有德降清","text":"登州兵变，孔有德携红衣大炮降后金，敌我火力此消彼长。","effects":{"delta":[0,0,-4,-2],"frontier":{"manchu":4,"relations":-3}},"choices":[{"label":"厚抚军士","effects":{"delta":[-40,0,2,1]}},{"label":"严惩叛将","effects":{"delta":[0,0,1,-3]}}]},
  {"id":"qing-1636","year":1636,"title":"皇太极称帝","text":"皇太极改国号大清，正式与明分庭抗礼。","effects":{"delta":[0,0,-2,-3],"frontier":{"manchu":4},"rivals":[{"id":"hongtaiji","title":"清太宗","strength":5}]},"choices":[{"label":"遣使申斥","effects":{"delta":[0,0,1,-2]}},{"label":"隐忍不发","effects":{"delta":[0,-1,0,1]}}]},
  {"id":"korea-1637","year":1637,"title":"朝鲜臣服","text":"朝鲜兵败，转奉清为宗主，辽东侧翼尽失。","effects":{"delta":[0,0,-3,-2],"frontier":{"manchu":3}},"choices":[{"label":"派军援朝","effects":{"delta":[-50,-2,3,-1]}},{"label":"静观其变","effects":{"delta":[0,0,-2,1]}}]},
