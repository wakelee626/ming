  {"id":"korea-1637","year":1637,"title":"朝鲜臣服","text":"朝鲜兵败，转奉清为宗主，辽东侧翼尽失。","effects":{"delta":[0,0,-3,-2],"frontier":{"manchu":3}},"choices":[{"label":"派军援朝","effects":{"delta":[-50,-2,3,-1]},"sets":["aid-korea"]},{"label":"静观其变","effects":{"delta":[0,0,-2,1]},"sets":["abandon-korea"]}]},
  {"id":"raids-1638","year":1638,"title":"清军入塞","text":"清军第五次入塞，掳掠人口财物无数，京畿再遭蹂躏。","effects":{"delta":[-60,-6,-3,-2],"provinces":[{"id":"beizhili","delta":[-6,-6,-3,0]}],"armies":[{"id":"jizhen-jun","men":-2000,"morale":-8},{"id":"jingying","men":-2000,"morale":-8}],"frontier":{"manchu":3},"rivals":[{"id":"duoergun","strength":5}]},"choices":[{"label":"坚壁清野","effects":{"delta":[0,2,2,0]},"sets":["scorched-earth"]},{"label":"出城迎击","effects":{"delta":[-30,0,4,-1]},"sets":["field-battle"]}]},
  {"id":"gucheng-1639","year":1639,"title":"张献忠谷城复叛","text":"张献忠在谷城复叛，席卷湖广，围剿大军顾此失彼。","effects":{"delta":[-40,-5,-3,-3],"provinces":[{"id":"huguang","delta":[-4,-6,-4,0]}],"armies":[{"id":"huguang-jun","men":-2500,"morale":-10}],"rivals":[{"id":"zhangxianzhong","strength":12,"influence":10}]},"variants":[{"requires":["appease-zhang"],"text":"昔日招抚的张献忠背约复叛，谷城再起，声势更炽。","effects":{"delta":[-50,-7,-4,-4],"provinces":[{"id":"huguang","delta":[-5,-8,-5,0]}],"armies":[{"id":"huguang-jun","men":-3500,"morale":-14}],"rivals":[{"id":"zhangxianzhong","strength":16,"influence":12}]}},{"requires":["hunt-zhang"],"text":"被剿的张献忠穷寇再起，谷城复叛，负隅顽抗。","effects":{"delta":[-30,-3,-2,-2],"provinces":[{"id":"huguang","delta":[-3,-4,-3,0]}],"armies":[{"id":"huguang-jun","men":-1800,"morale":-7}],"rivals":[{"id":"zhangxianzhong","strength":8,"influence":6}]}}],"choices":[{"label":"再行围剿","effects":{"delta":[-45,0,4,-1]},"sets":["hunt-zhang"]},{"label":"杨嗣昌督师","effects":{"delta":[-50,0,5,0]},"sets":["yang-sici"]}]},
  {"id":"famine-1640","year":1640,"title":"大旱蝗灾","text":"大旱继以蝗灾，赤地千里，饿殍遍野。","effects":{"delta":[-40,-8,0,-2],"provinces":[{"id":"henan","delta":[-2,-6,0,-1]},{"id":"shaanxi","delta":[-2,-6,0,-1]}]},"choices":[{"label":"开仓放粮","effects":{"delta":[-50,6,0,1]},"sets":["open-granaries"]},{"label":"征收留饷","effects":{"delta":[15,-4,0,-2]},"sets":["levy-famine"]}]},
  {"id":"songjin-1641","year":1641,"title":"松锦之战","text":"松山锦州相继失陷，洪承畴被俘降清，辽西尽丧。","effects":{"delta":[-80,-3,-8,-3],"provinces":[{"id":"liaodong","delta":[0,-3,-10,0]}],"armies":[{"id":"liaodong-jun","men":-6000,"morale":-20},{"id":"guanning-tieqi","men":-2000,"morale":-20}],"frontier":{"manchu":6},"rivals":[{"id":"hongtaiji","strength":8},{"id":"duoergun","strength":8}]},"choices":[{"label":"死守松锦","effects":{"delta":[-40,-1,5,-1]},"sets":["hold-songjin"]},{"label":"收缩防线","effects":{"delta":[10,0,-6,2]},"sets":["retreat-songjin"]}]},
