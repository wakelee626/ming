  {"id":"jiashen-1644","year":1644,"title":"甲申之变","text":"李自成破北京，崇祯自缢煤山，大明社稷危在旦夕。","effects":{"delta":[-120,-10,-8,-8],"rivals":[{"id":"lizicheng","strength":20,"influence":15}]},"choices":[{"label":"死守京城","effects":{"delta":[-40,-2,6,-2]},"sets":["defend-beijing"]},{"label":"迁都南京","effects":{"delta":[-80,2,-2,3]},"sets":["move-south"]}]}
